{
  "expo": {
    "name": "FixMe Fixer",
    "slug": "fixme-fixer",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "fixme-fixer",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fixme.fixer"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "package": "com.fixme.fixer"
    },
    "plugins": [],
    "experiments": {
      "tsconfigPaths": true
    }
  }
}
