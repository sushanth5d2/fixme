# Fix Me API — Environment Variables
# Copy this file to .env and fill in real values. NEVER commit .env with secrets.

# ── Application ────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=debug

# ── Database (PostgreSQL) ──────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=fixme
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_DATABASE=fixme_db

# ── Cache (Redis) ─────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT ───────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=CHANGE_ME_ACCESS_SECRET_MIN_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_SECRET_MIN_64_CHARS

# ── Object Storage (MinIO / S3-compatible) ────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
S3_SECRET_KEY=CHANGE_ME_SECRET_KEY
S3_REGION=ap-south-1
S3_BUCKET_CUSTOMER_MEDIA=fixme-customer-media
S3_BUCKET_FIXER_DOCUMENTS=fixme-fixer-documents
S3_BUCKET_REPAIR_MEDIA=fixme-repair-media
S3_BUCKET_MESSAGE_ATTACHMENTS=fixme-message-attachments

# ── CORS (comma-separated allowed origins) ────────────────
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# ── Rate Limiting ─────────────────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ── Email (SMTP, optional) ────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@fixme.com
SMTP_PASS=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=Fix Me <noreply@fixme.com>
