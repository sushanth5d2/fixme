  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@fixme/tsconfig": "*",
    "rimraf": "^5.0.5",
    "typescript": "^5.5.4"
  },
