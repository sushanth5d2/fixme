{
  "name": "@fixme/shared-types",
  "version": "1.0.0",
  "private": true,
  "description": "Shared TypeScript types for Fix Me monorepo",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
